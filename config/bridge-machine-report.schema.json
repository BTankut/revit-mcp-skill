{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpe.local/revagent/bridge-machine-report.schema.json",
  "title": "revAgent Bridge install/uninstall machine report",
  "description": "Emitted by installer/bridge/Install-RevAgentBridge.ps1 and installer/bridge/Uninstall-RevAgentBridge.ps1 (EU-20/M6, P3-T9/P3-T10). Written to <StateRoot>/reports/<action>-<timestamp>.json and <action>-latest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "app",
    "component",
    "action",
    "computerName",
    "userName",
    "dryRun",
    "status",
    "message",
    "startedAtUtc",
    "completedAtUtc",
    "steps",
    "install",
    "uninstall",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": { "const": "revAgent" },
    "component": { "const": "bridge" },
    "action": { "enum": ["install", "uninstall"] },
    "computerName": { "type": "string", "minLength": 1 },
    "userName": { "type": "string", "minLength": 1 },
    "dryRun": { "type": "boolean" },
    "status": { "enum": ["success", "failed"] },
    "message": { "type": "string" },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "action", "status", "detail"],
        "properties": {
          "target": { "type": "string" },
          "action": { "type": "string" },
          "status": {
            "enum": [
              "planned",
              "applied",
              "failed",
              "skipped_dry_run",
              "skipped_already_registered",
              "skipped_already_enrolled",
              "skipped_already_running",
              "verified"
            ]
          },
          "detail": { "type": ["string", "null"] }
        }
      }
    },
    "install": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "revitVersion",
            "revitDetected",
            "addinManifestPath",
            "addinManifestSha256",
            "serviceName",
            "enrollmentAttempted",
            "enrollmentArtifactWritten",
            "alreadyEnrolled",
            "serviceAlreadyInstalled",
            "icaclsInvokerInjected",
            "elevated"
          ],
          "properties": {
            "revitVersion": { "type": "string" },
            "revitDetected": { "type": ["string", "null"] },
            "addinManifestPath": { "type": ["string", "null"] },
            "addinManifestSha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
            "serviceName": { "type": "string" },
            "enrollmentAttempted": { "type": "boolean" },
            "enrollmentArtifactWritten": { "type": "boolean" },
            "alreadyEnrolled": { "type": "boolean" },
            "serviceAlreadyInstalled": { "type": "boolean" },
            "icaclsInvokerInjected": {
              "type": "boolean",
              "description": "true when the caller substituted the ACL primitive (-IcaclsInvoker) instead of the real icacls.exe. A report with this true was not produced by a genuine machine mutation and must never be accepted as true-gate lab evidence regardless of status/dryRun."
            },
            "elevated": {
              "type": "boolean",
              "description": "Whether the installer process was running as an elevated Administrator. A real (non-dry-run, non-mocked) install can only reach status=success when this is true, because the elevation gate refuses otherwise before any mutation."
            }
          }
        }
      ]
    },
    "uninstall": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["scheduledTasks", "legacyTrees", "codexConfig", "anchors", "serviceRemoved", "icaclsInvokerInjected", "elevated"],
          "properties": {
            "scope": { "enum": ["LegacyCutover", "BridgeOwned"] },
            "ownedCleanup": {
              "type": ["object", "null"],
              "description": "Explicit BridgeOwned plan/result; runtime and credential contents are not read or emitted. LegacyCutover leaves this null."
            },
            "scheduledTasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "found", "disposition"],
                "properties": {
                  "name": { "type": "string" },
                  "found": { "type": "boolean" },
                  "disposition": { "type": "string" }
                }
              }
            },
            "legacyTrees": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["root", "found", "items"],
                "properties": {
                  "root": { "type": "string" },
                  "found": { "type": "boolean" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["path", "kind", "disposition"],
                      "properties": {
                        "path": { "type": "string" },
                        "kind": { "enum": ["file", "directory"] },
                        "disposition": { "type": "string" }
                      }
                    }
                  }
                }
              }
            },
            "codexConfig": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["configPath", "existed", "sectionsRemoved", "unchangedElsewhere"],
                  "properties": {
                    "configPath": { "type": "string" },
                    "existed": { "type": "boolean" },
                    "sectionsRemoved": { "type": "array", "items": { "type": "string" } },
                    "unchangedElsewhere": { "type": "boolean" }
                  }
                }
              ]
            },
            "anchors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "hashBefore", "hashAfter", "preserved"],
                "properties": {
                  "path": { "type": "string" },
                  "hashBefore": { "type": ["string", "null"] },
                  "hashAfter": { "type": ["string", "null"] },
                  "preserved": { "const": true }
                }
              }
            },
            "serviceRemoved": { "type": "boolean" },
            "icaclsInvokerInjected": {
              "type": "boolean",
              "description": "The uninstaller never calls icacls; always false. Present for symmetry with the install report's evidence-forgeability field."
            },
            "elevated": {
              "type": "boolean",
              "description": "Whether the uninstaller process was running as an elevated Administrator."
            }
          }
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
