{
  "name": "@revagent/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bridge-release-import": "node ./dist/bridgeReleaseImportCli.js",
    "prebuild": "npm run build:self --workspace @revagent/protocol",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts",
    "pretypecheck": "npm run build --workspace @revagent/bridge-simulator",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:self --workspace @revagent/protocol",
    "test": "npm run build && npm run build --workspace @revagent/addin-loopback-fixture && npm run build --workspace @revagent/bridge-simulator && npm run package:handlers && npm run test:gateway && npm run test:eu11",
    "test:gateway": "vitest run --exclude src/m5EnrollmentEntitlement.test.ts",
    "test:eu11": "vitest run src/m5EnrollmentEntitlement.test.ts",
    "collect:registry": "node scripts/collect-registry.mjs",
    "package:handlers": "node scripts/package-handlers.mjs",
    "migrate:up": "npm run build && node dist/migrate.js",
    "readiness:gw13": "node scripts/run-gw13-readiness.mjs",
    "smoke:gw13": "node scripts/gw13-live-smoke.mjs",
    "start": "node dist/main.js",
    "start:preproduction": "node dist/preProductionServingMain.js"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@revagent/protocol": "0.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.11.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "ws": "^8.20.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.1"
  }
}
